# Copy to .env and adjust. Every key is optional; values below are the defaults.

# --- Logging ---
# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO

# --- Common Crawl ---
# Crawl to sample from (https://index.commoncrawl.org/collinfo.json)
CRAWL_ID=CC-MAIN-2026-39
INDEX_HOST=https://index.commoncrawl.org
DATA_HOST=https://data.commoncrawl.org
# Language code from the CDX index (CLD2, ISO 639-3)
INDEX_LANGUAGE=pol

# --- HTTP client ---
USER_AGENT_NAME=AMC-student-research/0.1
# Appended to the User-Agent; Common Crawl asks for a contact address
CONTACT_EMAIL=
REQUEST_TIMEOUT_SECONDS=90.0
MAX_RETRIES=5
RETRY_BACKOFF_SECONDS=1.0
INDEX_DELAY_SECONDS=1.0
WARC_DELAY_SECONDS=0.5
# Parallel WARC downloads; keep low, Common Crawl throttles heavy traffic
WORKERS=4

# --- Sampling and filtering ---
ARTICLES_PER_DOMAIN=20
MAX_FETCH_PER_DOMAIN=100
INDEX_PAGES_PER_DOMAIN=3
MIN_URL_PATH_LENGTH=25
MIN_WORDS=150
# Keep only articles published in this year (e.g. 2026); empty = any year.
# Articles without a detectable publication date are rejected when set.
PUB_YEAR=
HTML_SNIFF_CHARS=300000
SEED=42

# --- Paths ---
# Defaults to <project root>/data; uncomment to override (absolute path advised)
# DATA_DIR=/absolute/path/to/data
