# Copy to .env and adjust. Every key is optional; values below are the defaults.

# --- Logging ---
# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO

# --- Common Crawl ---
# Which crawl each publication year is taken from: see config/crawls.yaml
DATA_HOST=https://data.commoncrawl.org
# Primary language of a capture in the index (CLD2, ISO 639-3)
INDEX_LANGUAGE=pol

# --- HTTP client ---
USER_AGENT_NAME=AMC-student-research/0.1
# Appended to the User-Agent; Common Crawl asks for a contact address
CONTACT_EMAIL=
REQUEST_TIMEOUT_SECONDS=90.0
MAX_RETRIES=5
RETRY_BACKOFF_SECONDS=1.0
WARC_DELAY_SECONDS=0.5
# Parallel WARC downloads; keep low, Common Crawl throttles heavy traffic
WORKERS=4
# DuckDB threads reading the Parquet index; the CDN throttles above ~4
INDEX_THREADS=2
# Threads for the one-off read of the 300 Parquet footers of a crawl (cached after)
LAYOUT_THREADS=8

# --- Sampling and filtering ---
# Quota per domain and publication year (each year is fetched from its own crawl)
ARTICLES_PER_DOMAIN_YEAR=20
# Max WARC records downloaded per domain and year (and candidates taken from the index)
MAX_FETCH_PER_DOMAIN=600
MIN_URL_PATH_LENGTH=25
MIN_WORDS=150
# Comma-separated domains exempt from the article-markup test (og:type/schema.org),
# e.g. small portals on a custom CMS. Pages must still have MIN_WORDS and a date.
# Match the domain exactly as written in domains.csv.
RELAXED_DOMAINS=
HTML_SNIFF_CHARS=300000
SEED=42

# --- Paths ---
# Defaults to <project root>/data; uncomment to override (absolute path advised)
# DATA_DIR=/absolute/path/to/data
